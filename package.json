{
  "name": "comment-ratio",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that fails pull requests whose added code outpaces added comments. Powered by tokei.",
  "keywords": [
    "code-comment-ratio",
    "code-quality",
    "code-review",
    "comment-coverage",
    "comment-density",
    "comment-ratio",
    "comment-to-code-ratio",
    "comments",
    "documentation",
    "github-action",
    "github-actions",
    "pull-request",
    "static-analysis",
    "tokei"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IgnaceMaes/comment-ratio.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "release:version": "changeset version",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify-dist": "pnpm build && git diff --exit-code --stat -- dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "picomatch": "^4.0.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.0",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0"
}
